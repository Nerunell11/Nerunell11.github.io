---
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** ヒーローのように、ページ最上部から背景を見せたいときは false にする */
  padTop?: boolean;
}

const { title, description = SITE.description, padTop = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

// SNS に貼ったときのサムネイル。
// public/og.png（1200x630 推奨）を置くと、自動で使われるようになります。
const OG_IMAGE_EXISTS = false;
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    {OG_IMAGE_EXISTS && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={OG_IMAGE_EXISTS ? 'summary_large_image' : 'summary'} />

    <meta name="theme-color" content="#08090c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- JS が有効なときだけ出現アニメを適用する。無効でも本文は必ず表示される。 -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <div class="grain" aria-hidden="true"></div>

    <Header />

    <main id="main" class={padTop ? 'pad-top' : undefined}>
      <slot />
    </main>

    <Footer />

    <style>
      .pad-top {
        padding-top: calc(var(--header-h) + clamp(48px, 8vw, 96px));
      }
    </style>

    <script>
      // スクロールで要素を出現させる。
      // IntersectionObserver が無い環境では最初から表示する。
      const targets = document.querySelectorAll('[data-reveal]');

      if (!('IntersectionObserver' in window)) {
        targets.forEach((el) => el.classList.add('shown'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('shown');
              io.unobserve(entry.target);
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.04 }
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
