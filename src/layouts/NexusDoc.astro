---
import Base from './Base.astro';
import MermaidDiagrams from '../components/MermaidDiagrams.astro';
import { moduleById, moduleHref, plainLabel, subsystemHref, type MapModule } from '../data/nexus-architecture';
import 'katex/dist/katex.min.css';
import '../styles/prose.css';

interface Props {
  mod: MapModule;
  /** サブシステムのページなら、その slug。モジュールの概要なら省略 */
  slug?: string;
}

const { mod, slug } = Astro.props;

const siblings = mod.blocks.filter((b) => b.slug);
const index = siblings.findIndex((b) => b.slug === slug);
const current = slug ? siblings[index] : undefined;
const prev = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const title = current ? plainLabel(current.label) : mod.label;
---

<Base title={`${title} | Nexus`} description={`Nexus エンジンの${mod.label}${current ? `: ${title}` : ''}`} padTop>
  <article class="doc">
    <header class="wrap doc-head">
      <nav class="crumbs mono-label" aria-label="現在の位置">
        <a href="/works/nexus/#architecture">← Nexus 全体構成</a>
        {
          current && (
            <>
              <span aria-hidden="true">/</span>
              <a href={moduleHref(mod.id)}>{mod.label}</a>
            </>
          )
        }
      </nav>
      <p class="doc-name">{current ? `${mod.name} / ${title}` : mod.name}</p>
      <h1 class="doc-title">{title}</h1>
      {
        !current && mod.deps && mod.deps.length > 0 && (
          <p class="doc-deps">
            依存先
            {mod.deps.map((dep) => (
              <a href={moduleHref(dep)}>{moduleById(dep)?.name}</a>
            ))}
          </p>
        )
      }
    </header>

    <div class="wrap doc-grid">
      <div class="prose doc-body">
        <slot />

        {
          !current && siblings.length > 0 && (
            <ul class="doc-cards">
              {siblings.map((b) => (
                <li>
                  <a href={subsystemHref(mod.id, b.slug!)}>{plainLabel(b.label)}</a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        siblings.length > 0 && (
          <nav class="doc-side" aria-label={`${mod.label}のサブシステム`}>
            <a class="mono-label doc-side-title" href={moduleHref(mod.id)}>
              {mod.label}
            </a>
            <ul>
              {siblings.map((b) => (
                <li>
                  <a
                    href={subsystemHref(mod.id, b.slug!)}
                    class:list={{ 'is-active': b.slug === slug }}
                    aria-current={b.slug === slug ? 'page' : undefined}
                  >
                    {plainLabel(b.label)}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>

    {
      current && (
        <nav class="wrap doc-pager" aria-label="同じモジュールの前後">
          {prev ? (
            <a href={subsystemHref(mod.id, prev.slug!)}>
              <span class="mono-label">← Prev</span>
              <span class="doc-pager-title">{plainLabel(prev.label)}</span>
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a class="is-next" href={subsystemHref(mod.id, next.slug!)}>
              <span class="mono-label">Next →</span>
              <span class="doc-pager-title">{plainLabel(next.label)}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }
  </article>
</Base>

<MermaidDiagrams />

<style>
  .doc {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(72px, 10vw, 140px);
  }

  .doc-head {
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: 26px;
    color: var(--text-faint);
  }

  .crumbs a {
    transition: color 0.25s var(--ease);
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  .doc-name {
    font-family: var(--f-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }

  .doc-title {
    margin-top: 6px;
    font-family: var(--f-display);
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .doc-deps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 14px;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .doc-deps a {
    padding: 1px 8px;
    border: 1px solid var(--line-hi);
    border-radius: 3px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    color: var(--accent-hi);
  }

  .doc-deps a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .doc-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  /* この層の本文は h3 から始まり、開閉式の節に包まれないので余白をここで持つ */
  .doc-body :global(h3) {
    margin: 2.2em 0 0.6em;
  }

  .doc-body :global(h3:first-child) {
    margin-top: 0;
  }

  .doc-body :global(video),
  .doc-body :global(img) {
    width: 100%;
  }

  .prose ul.doc-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 8px;
    margin: 2em 0 0;
    padding: 0;
    list-style: none;
  }

  .prose .doc-cards li {
    margin: 0;
  }

  .prose .doc-cards a {
    display: block;
    padding: 12px 14px;
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    transition: border-color 0.25s var(--ease);
  }

  .prose .doc-cards a:hover {
    border-color: var(--accent);
    color: var(--accent-hi);
  }

  .doc-side {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .doc-side-title {
    display: block;
    margin-bottom: 10px;
  }

  .doc-side ul {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }

  .doc-side li a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 1px solid transparent;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-faint);
    transition: color 0.2s var(--ease);
  }

  .doc-side li a:hover {
    color: var(--text);
  }

  .doc-side li a.is-active {
    border-left-color: var(--accent);
    color: var(--accent-hi);
  }

  .doc-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(48px, 7vw, 80px);
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .doc-pager a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: border-color 0.3s var(--ease);
  }

  .doc-pager a:hover {
    border-color: var(--accent);
  }

  .doc-pager a.is-next {
    align-items: flex-end;
    text-align: right;
  }

  .doc-pager-title {
    font-family: var(--f-display);
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .doc-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .doc-side {
      position: static;
    }
  }
</style>
