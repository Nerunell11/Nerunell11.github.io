---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchitectureMap from '../../components/ArchitectureMap.astro';
import MermaidDiagrams from '../../components/MermaidDiagrams.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const works = (
    await getCollection('works', ({ data }) => import.meta.env.DEV || !data.draft)
  ).sort((a, b) => a.data.order - b.data.order);

  return works.map((work, i) => ({
    params: { slug: work.id },
    props: {
      work,
      prev: works[i - 1] ?? null,
      next: works[i + 1] ?? null,
    },
  }));
}

interface Props {
  work: CollectionEntry<'works'>;
  prev: CollectionEntry<'works'> | null;
  next: CollectionEntry<'works'> | null;
}

const { work, prev, next } = Astro.props;
const { Content, headings } = await render(work);
const d = work.data;
// 目次には h2 と h3 だけを出す（h4 まで出すと長くなりすぎる）
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

---

<Base title={d.title} description={d.summary} padTop>
  <article class="work">
    <!-- 見出し -->
    <header class="wrap head">
      <a class="back mono-label" href="/#works">← Works</a>

      <p class="meta">
        <span>{d.period}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{d.category}</span>
        {d.released && <span class="released">公開中</span>}
        {
          d.ongoing && (
            <span class="live">
              <span class="live-dot" aria-hidden="true" />
              開発中
            </span>
          )
        }
      </p>

      {d.awards.length > 0 && (
        <p class="awards">{d.awards.map((a) => <span class="award">{a.label}</span>)}</p>
      )}

      <h1 class="display title">{d.title}</h1>
      <p class="summary">{d.summary}</p>
    </header>

    {
      d.cover && (
        <div class="wrap cover">
          <img src={d.cover} alt={`${d.title} のスクリーンショット`} />
        </div>
      )
    }

    {
      work.id === 'nexus' && (
        <div class="wrap">
          <ArchitectureMap pageHeadings={headings} />
        </div>
      )
    }

    <!-- 本文とサイドの情報 -->
    <div class="wrap grid">
      <div class="prose">
        <Content />
      </div>

      <div class="side-col">
      <aside class="side">
        <section class="block">
          <h2 class="mono-label">制作期間</h2>
          <p>{d.period}</p>
        </section>

        {
          d.role && (
            <section class="block">
              <h2 class="mono-label">担当</h2>
              <p>{d.role}</p>
            </section>
          )
        }

        {
          d.awards.length > 0 && (
            <section class="block">
              <h2 class="mono-label">受賞</h2>
              {d.awards.map((a) => (
                <p>
                  {a.label}
                  {a.detail && <span class="award-detail">{a.detail}</span>}
                </p>
              ))}
            </section>
          )
        }

        <section class="block">
          <h2 class="mono-label">使用技術</h2>
          <ul class="tags">
            {d.tech.map((t) => <li class="tag tag-accent">{t}</li>)}
          </ul>
        </section>

        {
          d.links.length > 0 && (
            <section class="block">
              <h2 class="mono-label">リンク</h2>
              <ul class="links">
                {d.links.map((link) => (
                  <li>
                    <a href={link.url} target="_blank" rel="noopener">
                      {link.label}
                      <span aria-hidden="true">↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </aside>

      {
        toc.length > 1 && (
          <nav class="toc" aria-label="目次">
            <p class="mono-label toc-title">目次</p>
            <ol>
              {toc.map((h) => (
                <li class={`toc-d${h.depth}`}>
                  <a href={`#${h.slug}`} data-slug={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      </div>
    </div>

    <!-- 前後の作品 -->
    <nav class="wrap pager" aria-label="他の作品">
      {
        prev ? (
          <a class="pager-link prev" href={`/works/${prev.id}/`}>
            <span class="mono-label">← Prev</span>
            <span class="pager-title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager-link next" href={`/works/${next.id}/`}>
            <span class="mono-label">Next →</span>
            <span class="pager-title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</Base>

<style>
  .work {
    position: relative;
    z-index: 2;
    padding-bottom: clamp(72px, 10vw, 140px);
  }

  .head {
    max-width: 920px;
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--text-faint);
    transition: color 0.25s var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 18px;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 11px 3px 9px;
    border: 1px solid var(--hot-line);
    border-radius: 999px;
    background: var(--hot-soft);
    color: var(--hot-hi);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  /* 公開・配布中を示すバッジ。主色（アクセント）で受け、マゼンタ・琥珀と区別する。 */
  .released {
    display: inline-flex;
    align-items: center;
    padding: 3px 11px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-hi);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--hot);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(221, 10, 177, 0.65);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(221, 10, 177, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(221, 10, 177, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }

  .title {
    font-size: clamp(2.6rem, 9vw, 6rem);
    margin-bottom: 24px;
  }

  .summary {
    white-space: pre-line;
    max-width: 60ch;
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    color: var(--text-dim);
  }

  .cover {
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .cover img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }

  /* ---------- サイド ---------- */
  /* 列は本文の高さいっぱいに伸ばし、その中で目次だけを追従させる */
  .side-col {
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .toc {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    max-height: calc(100vh - var(--header-h) - 64px);
    overflow-y: auto;
    padding: 22px 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .toc-title {
    margin-bottom: 12px;
  }

  .toc ol {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
  }

  .toc a {
    display: block;
    margin-left: -1px;
    padding: 5px 0 5px 14px;
    border-left: 1px solid transparent;
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--text-faint);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease);
  }

  .toc .toc-d3 a {
    padding-left: 28px;
    font-size: 0.8rem;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a.is-active {
    color: var(--accent-hi);
    border-left-color: var(--accent);
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .block h2 {
    margin-bottom: 12px;
  }

  .block p {
    font-size: 0.92rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--accent-hi);
    transition: color 0.25s var(--ease);
  }

  .links a:hover {
    color: var(--accent);
  }

  /* ---------- 前後 ---------- */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: clamp(56px, 8vw, 100px);
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 0.3s var(--ease),
      background-color 0.3s var(--ease);
  }

  .pager-link:hover {
    border-color: var(--accent);
    background: var(--surface);
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }

  .pager-title {
    font-family: var(--f-display);
    font-size: 1.1rem;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    /* minmax(0, 1fr) にしないと、表のような広い中身に列が引き伸ばされる */
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    /* 1列のときはサイドが本文の後ろに来るので、目次は出さない */
    .toc {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }

  .award-detail {
    display: block;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  /* 受賞はメタ行に詰めず、正式名称のまま独立した行に出す */
  .awards {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0 0 14px;
  }

  /* 受賞バッジ。開発中バッジ（マゼンタ）と区別するため琥珀色にする */
  .award {
    display: inline-flex;
    align-items: center;
    padding: 3px 11px;
    border: 1px solid rgba(255, 181, 71, 0.38);
    border-radius: 999px;
    background: rgba(255, 181, 71, 0.1);
    color: var(--award);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }

</style>

<script>
  // 目次: 閉じた節の中へ飛ぶときは先に節を開く。読んでいる位置の見出しを強調する
  const openTo = (el: Element | null) => {
    for (let p = el?.parentElement; p; p = p.parentElement) {
      if (p instanceof HTMLDetailsElement) p.open = true;
    }
  };

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-slug]'));
  const targets = links.map((a) => document.getElementById(a.dataset.slug!));

  for (const a of links) {
    a.addEventListener('click', () => openTo(document.getElementById(a.dataset.slug!)));
  }
  if (location.hash) openTo(document.getElementById(decodeURIComponent(location.hash.slice(1))));

  if (links.length > 0) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const line = window.innerHeight * 0.3;
      let current = -1;
      targets.forEach((t, i) => {
        if (!t) return;
        const r = t.getBoundingClientRect();
        // 閉じた節の中の見出しは大きさが 0 になるので数えない
        if (r.height > 0 && r.top <= line) current = i;
      });
      // 一番下まで来たら、画面内にある最後の見出しを選ぶ（短い最後の節が選ばれないままになるため）
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4) {
        targets.forEach((t, i) => {
          const r = t?.getBoundingClientRect();
          if (r && r.height > 0 && r.top < window.innerHeight) current = i;
        });
      }
      links.forEach((a, i) => a.classList.toggle('is-active', i === current));
    };
    const request = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', request, { passive: true });
    window.addEventListener('resize', request);
    document.querySelectorAll('.prose details').forEach((d) => d.addEventListener('toggle', request));
    update();
  }
</script>

<MermaidDiagrams />
