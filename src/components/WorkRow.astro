---
/**
 * 作品一覧の1行。
 * 小さいカードを並べるのをやめ、1件を大きく見せる。
 * 偶数番目は CSS で左右を入れ替えて、スクロールに律動をつける。
 */
interface Props {
  slug: string;
  index: number;
  title: string;
  period: string;
  category: string;
  /** 個人開発など、担当を書く必要がない作品では渡されない */
  role?: string;
  tech: string[];
  summary: string;
  cover?: string;
  /** 継続中の作品。「開発中」バッジを出す */
  ongoing?: boolean;
  awards?: { label: string; detail?: string }[];
}

const { slug, index, title, period, category, role, tech, summary, cover, ongoing, awards = [] } =
  Astro.props;
const num = String(index + 1).padStart(2, '0');
---

<article class="row" data-tech={tech.join('|')} data-reveal>
  <a class="row-link" href={`/works/${slug}/`} aria-label={`${title} の詳細を見る`}>
    <div class:list={['visual', !cover && 'is-placeholder']}>
      {
        cover ? (
          <img src={cover} alt={`${title} のスクリーンショット`} loading="lazy" decoding="async" />
        ) : (
          <span class="ph" aria-hidden="true">
            {title.trim().charAt(0).toUpperCase()}
          </span>
        )
      }
      <span class="num" aria-hidden="true">{num}</span>
    </div>

    <div class="body">
      <p class="meta">
        <span>{period}</span>
        <span class="dot" aria-hidden="true"></span>
        <span>{category}</span>
        {ongoing && (
          <span class="live">
            <span class="live-dot" aria-hidden="true" />
            開発中
          </span>
        )}
        {awards.map((a) => <span class="award">{a.label}</span>)}
      </p>

      <h3 class="title display">{title}</h3>

      {role && <p class="role"><span>担当</span>{role}</p>}
      <p class="summary">{summary}</p>

      <ul class="tags">
        {tech.map((t) => <li class="tag">{t}</li>)}
      </ul>

      <span class="more mono-label">
        View work
        <span class="arrow" aria-hidden="true">→</span>
      </span>
    </div>
  </a>
</article>

<style>
  .row {
    border-top: 1px solid var(--line);
  }

  .row:last-child {
    border-bottom: 1px solid var(--line);
  }

  .row-link {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
    padding: clamp(28px, 4vw, 52px) 0;
    transition: background-color 0.4s var(--ease);
  }

  .row-link:hover {
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
  }

  /* 偶数番目は左右を反転させる */
  .row:nth-child(even) .visual {
    order: 2;
  }

  /* ゲーム画面の多くが 16:9 なので、それに合わせて上下を切らないようにする */
  .visual {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raise);
    display: grid;
    place-items: center;
  }

  .visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.7s var(--ease),
      filter 0.5s var(--ease);
    /* タイトル画面は暗いものが多いので、わずかに持ち上げて潰れを防ぐ */
    filter: brightness(1.08);
  }

  .row-link:hover .visual img {
    transform: scale(1.04);
    filter: brightness(1.18);
  }

  /* 画像が無いときの代替。文字だけで寂しくならないよう熱源を置く。 */
  .ph {
    font-family: var(--f-display);
    font-size: clamp(3rem, 9vw, 6rem);
    font-weight: 700;
    color: rgba(244, 242, 239, 0.14);
  }

  .visual.is-placeholder::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(90% 70% at 25% 15%, rgba(255, 107, 44, 0.16), transparent 65%);
    pointer-events: none;
  }

  /* 連番の下だけ暗く沈めて、明るいスクリーンショットでも数字が読めるようにする */
  .visual::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    background: linear-gradient(to top, rgba(5, 6, 9, 0.75), transparent);
    pointer-events: none;
  }

  .num {
    position: absolute;
    z-index: 1;
    left: 14px;
    bottom: 8px;
    font-family: var(--f-mono);
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    font-weight: 500;
    line-height: 1;
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin-bottom: 14px;
  }

  .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* 継続中であることを示すバッジ。点が静かに明滅する。 */
  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 3px 11px 3px 9px;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-hi);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: none;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 rgba(255, 107, 44, 0.7);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(255, 107, 44, 0.65);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(255, 107, 44, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(255, 107, 44, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .live-dot {
      animation: none;
    }
  }

  .title {
    font-size: clamp(1.8rem, 4.5vw, 3rem);
    margin-bottom: 16px;
    transition: color 0.3s var(--ease);
  }

  .row-link:hover .title {
    color: var(--accent-hi);
  }

  .role {
    display: flex;
    gap: 12px;
    font-size: 0.88rem;
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .role span {
    flex: none;
    font-family: var(--f-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    color: var(--accent);
    padding-top: 0.35em;
  }

  .summary {
    white-space: pre-line;
    color: var(--text-dim);
    font-size: 0.95rem;
    margin-bottom: 20px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-bottom: 24px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.35s var(--ease);
  }

  .row-link:hover .arrow {
    transform: translateX(7px);
  }

  @media (max-width: 860px) {
    .row-link {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .row:nth-child(even) .visual {
      order: 0;
    }
  }

  /* 受賞バッジ。開発中バッジ（橙）と区別するため琥珀色にする */
  .award {
    display: inline-flex;
    align-items: center;
    padding: 3px 11px;
    border: 1px solid rgba(255, 181, 71, 0.38);
    border-radius: 999px;
    background: rgba(255, 181, 71, 0.1);
    color: var(--accent-warm);
    font-family: var(--f-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: none;
  }
</style>
