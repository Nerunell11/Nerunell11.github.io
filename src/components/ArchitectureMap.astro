---
import { ARCHITECTURE, mapLabel, moduleHref, subsystemHref, type MapBlock, type MapModule } from '../data/nexus-architecture';

interface Heading {
  slug: string;
  text: string;
}

interface Props {
  /** 作品ページ本文の見出し。デモのブロックの飛び先に使う */
  pageHeadings: Heading[];
}

const { pageHeadings } = Astro.props;

const pageAnchor = (text: string) => {
  const found = pageHeadings.find((h) => h.text === text);
  if (!found) throw new Error(`構成図: nexus.md に見出し「${text}」がありません`);
  return `#${found.slug}`;
};

const headHref = (mod: MapModule) => (mod.pageHeading ? pageAnchor(mod.pageHeading) : moduleHref(mod.id));

const blockHref = (mod: MapModule, block: MapBlock) => {
  if (block.pageHeading) return pageAnchor(block.pageHeading);
  return block.slug ? subsystemHref(mod.id, block.slug) : moduleHref(mod.id);
};
---

<section class="map" id="architecture" aria-labelledby="map-title">
  <header class="map-head">
    <h2 id="map-title" class="map-title">全体構成</h2>
    <p class="map-hint">ブロックをクリックすると、そのサブシステムの解説を開きます。上の段が下の段を使います。</p>
  </header>

  <div class="map-body" data-map>
    {
      ARCHITECTURE.map((row) => (
        <div class="map-row">
          <p class="map-tier mono-label">{row.title}</p>
          <div class="map-mods">
            {row.modules.map((mod) => (
              <div
                class:list={['mod', { 'mod-accent': mod.accent }]}
                style={`--span:${mod.span}`}
                data-mod={mod.id}
                data-deps={(mod.deps ?? []).join(' ')}
              >
                <a class="mod-head" href={headHref(mod)}>
                  <span class="mod-label">{mod.label}</span>
                  <span class="mod-name">{mod.name}</span>
                  {mod.note && <span class="mod-note">{mod.note}</span>}
                </a>
                <ul class="mod-blocks" data-n={mod.blocks.length}>
                  {mod.blocks.map((block) => (
                    <li>
                      <a class="block" href={blockHref(mod, block)}>
                        {mapLabel(block.label)}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <ul class="map-legend" aria-label="ハイライトの見方">
    <li><span class="swatch swatch-source" aria-hidden="true"></span>カーソルを合わせたモジュール</li>
    <li><span class="swatch swatch-dep" aria-hidden="true"></span>それが直接使っているモジュール（CMake の依存先）</li>
  </ul>
</section>

<style>
  .map {
    margin-bottom: clamp(48px, 7vw, 88px);
  }

  .map-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
    margin-bottom: 20px;
  }

  .map-title {
    font-family: var(--f-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .map-hint {
    font-size: 0.86rem;
    color: var(--text-dim);
  }

  .map-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(10px, 1.6vw, 18px);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-sink);
  }

  .map-tier {
    margin-bottom: 4px;
    font-size: 0.62rem;
    color: var(--text-faint);
  }

  .map-mods {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .mod {
    flex: var(--span) 1 0;
    min-width: min(100%, 190px);
    display: flex;
    flex-direction: column;
    container-type: inline-size;
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }

  .mod-accent {
    border-color: var(--accent-line);
    background: linear-gradient(var(--accent-soft), var(--accent-soft)), var(--surface);
  }

  /* カーソルを合わせたモジュールと、それが直接使うモジュールを示す */
  .map-body.is-tracing .mod {
    opacity: 0.42;
  }

  .map-body.is-tracing .mod.is-source,
  .map-body.is-tracing .mod.is-dep {
    opacity: 1;
  }

  .map-body.is-tracing .mod.is-source {
    border-color: var(--accent);
  }

  .map-body.is-tracing .mod.is-dep {
    border-color: var(--hot-hi);
  }

  .map-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    margin-top: 12px;
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  .map-legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .swatch {
    flex: none;
    width: 14px;
    height: 10px;
    border: 1px solid;
    border-radius: 2px;
  }

  .swatch-source {
    border-color: var(--accent);
  }

  .swatch-dep {
    border-color: var(--hot-hi);
  }

  /* タッチ操作ではカーソルを合わせられないので、凡例を出さない */
  @media (hover: none) {
    .map-legend {
      display: none;
    }
  }

  .mod-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
    padding: 7px 10px 6px;
    border-radius: var(--radius) var(--radius) 0 0;
    transition: background-color 0.2s var(--ease);
  }

  .mod-head:hover {
    background: var(--surface-hi);
  }

  .mod-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
  }

  .mod-name {
    font-family: var(--f-mono);
    font-size: 0.68rem;
    color: var(--text-faint);
  }

  .mod-note {
    margin-left: auto;
    font-size: 0.68rem;
    color: var(--hot-hi);
  }

  .mod-blocks {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    gap: 5px;
    padding: 0 8px 8px;
  }

  /* ブロックが1つだけ余って段に残らないよう、数と幅から列数を決める */
  .mod-blocks[data-n='1'] {
    --cols: 1;
  }

  @container (min-width: 240px) {
    .mod-blocks[data-n='3'] {
      --cols: 3;
    }
  }

  @container (min-width: 300px) {
    .mod-blocks[data-n='5'],
    .mod-blocks[data-n='6'],
    .mod-blocks[data-n='9'] {
      --cols: 3;
    }
  }

  @container (min-width: 430px) {
    .mod-blocks[data-n='4'],
    .mod-blocks[data-n='8'] {
      --cols: 4;
    }
  }

  @container (min-width: 640px) {
    .mod-blocks[data-n='5'] {
      --cols: 5;
    }

    .mod-blocks[data-n='6'] {
      --cols: 6;
    }
  }

  @container (min-width: 900px) {
    .mod-blocks[data-n='8'] {
      --cols: 8;
    }

    .mod-blocks[data-n='9'] {
      --cols: 9;
    }
  }

  .block {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 34px;
    padding: 5px 6px;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--bg-raise);
    font-size: 0.78rem;
    line-height: 1.4;
    text-align: center;
    /* 語の途中では折り返さず、ラベルに入れたゼロ幅スペースの位置で折り返す。
       それでも入らないときだけ、はみ出す代わりに文字の間で折る */
    word-break: keep-all;
    overflow-wrap: anywhere;
    color: var(--text-dim);
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  .block:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent-hi);
  }

  .mod-head:focus-visible,
  .block:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  @media (max-width: 560px) {
    .mod {
      flex-basis: 100%;
    }
  }
</style>

<script>
  const map = document.querySelector<HTMLElement>('[data-map]');

  if (map) {
    // デモのブロックは本文へ飛ぶ。閉じた節の中なら先に開く
    map.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
      if (!a) return;
      const target = document.getElementById(decodeURIComponent(a.hash.slice(1)));
      for (let p = target?.parentElement; p; p = p.parentElement) {
        if (p instanceof HTMLDetailsElement) p.open = true;
      }
    });

    // 依存先の強調
    const mods = Array.from(map.querySelectorAll<HTMLElement>('[data-mod]'));
    const clear = () => {
      map.classList.remove('is-tracing');
      for (const m of mods) m.classList.remove('is-source', 'is-dep');
    };
    for (const mod of mods) {
      const deps = (mod.dataset.deps ?? '').split(' ').filter(Boolean);
      if (deps.length === 0) continue;
      const trace = () => {
        clear();
        map.classList.add('is-tracing');
        mod.classList.add('is-source');
        for (const m of mods) if (deps.includes(m.dataset.mod!)) m.classList.add('is-dep');
      };
      mod.addEventListener('mouseenter', trace);
      mod.addEventListener('mouseleave', clear);
      mod.addEventListener('focusin', trace);
      mod.addEventListener('focusout', clear);
    }
  }
</script>
